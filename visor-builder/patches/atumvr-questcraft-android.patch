--- /dev/null
+++ b/atumvr-core/src/main/java/me/phoenixra/atumvr/core/session/android/AndroidSupport.java
@@ -0,0 +1,87 @@
+package me.phoenixra.atumvr.core.session.android;
+
+import me.phoenixra.atumvr.api.exceptions.AtumVRException;
+import org.lwjgl.openxr.KHRAndroidCreateInstance;
+import org.lwjgl.openxr.KHRLoaderInit;
+import org.lwjgl.openxr.KHRLoaderInitAndroid;
+import org.lwjgl.openxr.KHROpenGLESEnable;
+import org.lwjgl.openxr.XrGraphicsBindingOpenGLESAndroidKHR;
+import org.lwjgl.openxr.XrGraphicsRequirementsOpenGLESKHR;
+import org.lwjgl.openxr.XrInstance;
+import org.lwjgl.openxr.XrInstanceCreateInfoAndroidKHR;
+import org.lwjgl.openxr.XrLoaderInitInfoAndroidKHR;
+import org.lwjgl.openxr.XrLoaderInitInfoBaseHeaderKHR;
+import org.lwjgl.system.MemoryStack;
+import org.lwjgl.system.Struct;
+import org.vivecraft.util.VLoader;
+
+import static org.lwjgl.system.MemoryUtil.NULL;
+
+/**
+ * What OpenXR needs on Android (standalone headsets): the loader gets the JVM and the activity, the instance is created
+ * with them, and the session binds the game's EGL context (OpenGL ES). Used by QuestCraft; on a desktop none of this runs.
+ */
+public final class AndroidSupport {
+    public static final String ANDROID_CREATE_INSTANCE_EXTENSION =
+            KHRAndroidCreateInstance.XR_KHR_ANDROID_CREATE_INSTANCE_EXTENSION_NAME;
+
+    private static final boolean ANDROID = detectAndroid();
+
+    private AndroidSupport() {
+    }
+
+    private static boolean detectAndroid() {
+        String version = System.getProperty("os.version");
+        return version != null && version.contains("Android");
+    }
+
+    public static boolean isAndroid() {
+        return ANDROID;
+    }
+
+    /** Before the first OpenXR call: hands the JVM and the activity to the loader. */
+    public static void initLoader() {
+        VLoader.setupAndroid();
+        try {
+            Thread.sleep(2500);   // the Android XR environment has to be up
+        } catch (InterruptedException ignored) {
+            Thread.currentThread().interrupt();
+        }
+        try (MemoryStack stack = MemoryStack.stackPush()) {
+            XrLoaderInitInfoAndroidKHR init = XrLoaderInitInfoAndroidKHR.calloc(stack).set(
+                    KHRLoaderInitAndroid.XR_TYPE_LOADER_INIT_INFO_ANDROID_KHR,
+                    NULL,
+                    VLoader.getDalvikVM(),
+                    VLoader.getDalvikActivity()
+            );
+            int result = KHRLoaderInit.xrInitializeLoaderKHR(XrLoaderInitInfoBaseHeaderKHR.create(init.address()));
+            if (result < 0) {
+                throw new AtumVRException("xrInitializeLoaderKHR failed: " + result);
+            }
+        }
+    }
+
+    /** The chain element of xrCreateInstance that carries the JVM and the activity. */
+    public static long instanceCreateInfo(MemoryStack stack) {
+        return XrInstanceCreateInfoAndroidKHR.calloc(stack).set(
+                KHRAndroidCreateInstance.XR_TYPE_INSTANCE_CREATE_INFO_ANDROID_KHR,
+                NULL,
+                VLoader.getDalvikVM(),
+                VLoader.getDalvikActivity()
+        ).address();
+    }
+
+    /** Checks what the runtime needs of OpenGL ES and binds the game's EGL display, config and context. */
+    public static Struct<?> graphicsBinding(MemoryStack stack, XrInstance instance, long systemId) {
+        XrGraphicsRequirementsOpenGLESKHR requirements = XrGraphicsRequirementsOpenGLESKHR.calloc(stack)
+                .type(KHROpenGLESEnable.XR_TYPE_GRAPHICS_REQUIREMENTS_OPENGL_ES_KHR);
+        KHROpenGLESEnable.xrGetOpenGLESGraphicsRequirementsKHR(instance, systemId, requirements);
+        return XrGraphicsBindingOpenGLESAndroidKHR.calloc(stack).set(
+                KHROpenGLESEnable.XR_TYPE_GRAPHICS_BINDING_OPENGL_ES_ANDROID_KHR,
+                NULL,
+                VLoader.getEGLDisplay(),
+                VLoader.getEGLConfig(),
+                VLoader.getEGLContext()
+        );
+    }
+}
diff --git a/atumvr-core/src/main/java/org/vivecraft/util/VLoader.java b/atumvr-core/src/main/java/org/vivecraft/util/VLoader.java
new file mode 100644
