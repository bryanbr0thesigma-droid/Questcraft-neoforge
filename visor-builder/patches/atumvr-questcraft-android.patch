--- /dev/null
+++ b/atumvr-core/src/main/java/org/vivecraft/util/VLoader.java
@@ -0,0 +1,24 @@
+package org.vivecraft.util;
+
+/**
+ * The native side of QuestCraft (libvloader.so, built into Pojlib): the JVM, the activity and the EGL objects of the
+ * game, which OpenXR on Android needs to create an instance and a session. The class has the name of the Vivecraft
+ * class because the native functions are bound to that name; Visor and Vivecraft are never loaded together.
+ */
+public class VLoader {
+    static {
+        System.loadLibrary("vloader");
+    }
+
+    public static native long getEGLContext();
+
+    public static native long getEGLConfig();
+
+    public static native long getEGLDisplay();
+
+    public static native long getDalvikVM();
+
+    public static native long getDalvikActivity();
+
+    public static native void setupAndroid();
+}
