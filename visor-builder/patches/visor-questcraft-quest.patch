diff --git a/visor-api/src/main/java/org/vmstudio/visor/api/client/input/action/QuestCraftBindings.java b/visor-api/src/main/java/org/vmstudio/visor/api/client/input/action/QuestCraftBindings.java
new file mode 100644
index 0000000..4769730
--- /dev/null
+++ b/visor-api/src/main/java/org/vmstudio/visor/api/client/input/action/QuestCraftBindings.java
@@ -0,0 +1,120 @@
+package org.vmstudio.visor.api.client.input.action;
+
+import me.phoenixra.atumvr.api.input.action.VRActionIdentifier;
+import me.phoenixra.atumvr.api.input.profile.VRInteractionProfileType;
+import me.phoenixra.atumvr.api.input.profile.types.OculusTouchProfile;
+import org.jetbrains.annotations.NotNull;
+
+import java.util.EnumMap;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * QuestCraft: on the Meta Quest controllers (Oculus Touch) Visor's default buttons are Vivecraft's
+ * (QuestCraft's Vivecraft, XRBindings.quest2Bindings), so both VR mods play the same:
+ * <pre>
+ * in game                                 in menus
+ *   right trigger   attack                  right trigger      click
+ *   left trigger    use                     A                  right click
+ *   A               jump                    left grip          shift
+ *   Y               inventory               right grip         middle click
+ *   left menu       pause menu              right thumbstick   scroll
+ *   grips           hotbar                  left menu          back
+ *   left stick      move                    both triggers      on-screen keyboard
+ *   right stick     turn
+ *   right stick in  sneak
+ * </pre>
+ * Left-handed mode mirrors it (A and X, B and Y, the triggers, grips and sticks swap sides), like Vivecraft does.
+ * Other controllers keep Visor's own defaults.
+ */
+public final class QuestCraftBindings {
+    /** Written next to the bindings once they follow this layout, so the old Visor defaults a player has saved are replaced once. */
+    public static final String LAYOUT = "vivecraft-1";
+    public static final String LAYOUT_PATH = "questcraft_layout";
+
+    private static final VRActionIdentifier NONE = ActionBinding.ID_EMPTY;
+
+    /** action set id -> action id -> right-handed button */
+    private static final Map<String, Map<String, VRActionIdentifier>> TABLE = new HashMap<>();
+
+    static {
+        Map<String, VRActionIdentifier> game = new HashMap<>();
+        game.put("mouse_left_main", OculusTouchProfile.BUTTON_TRIGGER_RIGHT);   // attack
+        game.put("mouse_left_offhand", NONE);
+        game.put("mouse_right_main", OculusTouchProfile.BUTTON_TRIGGER_LEFT);   // use
+        game.put("mouse_right_offhand", NONE);
+        game.put("mouse_middle_main", NONE);
+        game.put("mouse_middle_offhand", NONE);
+        game.put("mouse_scroll_main", NONE);                                    // the hotbar is on the grips
+        game.put("mouse_scroll_offhand", NONE);
+        game.put("shift", OculusTouchProfile.BUTTON_THUMBSTICK_RIGHT);          // sneak
+        game.put("menu", OculusTouchProfile.BUTTON_MENU);
+        game.put("screenshot", NONE);
+        game.put("movement", OculusTouchProfile.VEC2_THUMBSTICK_LEFT);
+        game.put("rotate", OculusTouchProfile.VEC2_THUMBSTICK_RIGHT);
+        game.put("jump", OculusTouchProfile.BUTTON_A);
+        game.put("inventory", OculusTouchProfile.BUTTON_Y);
+        game.put("hotbar_main", OculusTouchProfile.BUTTON_GRIP_RIGHT);
+        game.put("hotbar_offhand", OculusTouchProfile.BUTTON_GRIP_LEFT);
+        TABLE.put("game", game);
+
+        Map<String, VRActionIdentifier> menu = new HashMap<>();
+        menu.put("mouse_left_main", OculusTouchProfile.BUTTON_TRIGGER_RIGHT);   // click
+        menu.put("mouse_left_offhand", OculusTouchProfile.BUTTON_TRIGGER_LEFT); // Vivecraft's keyboard takes both triggers
+        menu.put("mouse_right_main", OculusTouchProfile.BUTTON_A);
+        menu.put("mouse_right_offhand", NONE);
+        menu.put("mouse_middle_main", OculusTouchProfile.BUTTON_GRIP_RIGHT);
+        menu.put("mouse_middle_offhand", NONE);
+        menu.put("mouse_scroll_main", OculusTouchProfile.VEC2_THUMBSTICK_RIGHT);
+        menu.put("mouse_scroll_offhand", NONE);
+        menu.put("shift", OculusTouchProfile.BUTTON_GRIP_LEFT);
+        menu.put("menu", OculusTouchProfile.BUTTON_MENU);
+        menu.put("screenshot", NONE);
+        TABLE.put("menu", menu);
+    }
+
+    private static final Map<VRActionIdentifier, VRActionIdentifier> MIRROR = new HashMap<>();
+
+    static {
+        pair(OculusTouchProfile.BUTTON_A, OculusTouchProfile.BUTTON_X);
+        pair(OculusTouchProfile.BUTTON_B, OculusTouchProfile.BUTTON_Y);
+        pair(OculusTouchProfile.BUTTON_TRIGGER_RIGHT, OculusTouchProfile.BUTTON_TRIGGER_LEFT);
+        pair(OculusTouchProfile.BUTTON_GRIP_RIGHT, OculusTouchProfile.BUTTON_GRIP_LEFT);
+        pair(OculusTouchProfile.BUTTON_THUMBSTICK_RIGHT, OculusTouchProfile.BUTTON_THUMBSTICK_LEFT);
+        pair(OculusTouchProfile.VEC2_THUMBSTICK_RIGHT, OculusTouchProfile.VEC2_THUMBSTICK_LEFT);
+        // the menu button only exists on the left controller, it stays there
+    }
+
+    private QuestCraftBindings() {
+    }
+
+    private static void pair(VRActionIdentifier a, VRActionIdentifier b) {
+        MIRROR.put(a, b);
+        MIRROR.put(b, a);
+    }
+
+    /** The button on the other controller (left-handed mode). */
+    public static @NotNull VRActionIdentifier mirror(@NotNull VRActionIdentifier id) {
+        return MIRROR.getOrDefault(id, id);
+    }
+
+    /** The QuestCraft binding of an action on the Quest controllers, or null if the table has none for it. */
+    public static ActionBinding binding(@NotNull String actionSetId, @NotNull String actionId) {
+        Map<String, VRActionIdentifier> set = TABLE.get(actionSetId);
+        if (set == null || !set.containsKey(actionId)) return null;
+        VRActionIdentifier right = set.get(actionId);
+        return new ActionBinding(right, mirror(right));
+    }
+
+    /** {@code defaults} with the Quest controller entry replaced by QuestCraft's, where the table has one. */
+    public static @NotNull Map<VRInteractionProfileType, ActionBinding> apply(@NotNull String actionSetId,
+                                                                              @NotNull String actionId,
+                                                                              @NotNull Map<VRInteractionProfileType, ActionBinding> defaults) {
+        ActionBinding quest = binding(actionSetId, actionId);
+        if (quest == null) return defaults;
+        Map<VRInteractionProfileType, ActionBinding> out = new EnumMap<>(VRInteractionProfileType.class);
+        out.putAll(defaults);
+        out.put(VRInteractionProfileType.OCULUS_TOUCH, quest);
+        return out;
+    }
+}
