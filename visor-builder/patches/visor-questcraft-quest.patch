@@ -0,0 +1,42 @@
+package org.vmstudio.visor.core.client.input.actions.game;
+
+import com.mojang.blaze3d.platform.InputConstants;
+import me.phoenixra.atumvr.api.input.profile.VRInteractionProfileType;
+import me.phoenixra.atumvr.api.input.profile.types.*;
+import org.vmstudio.visor.api.client.input.InputHelper;
+import org.vmstudio.visor.api.client.input.action.ActionBinding;
+import org.vmstudio.visor.api.client.input.action.VRActionSet;
+import org.vmstudio.visor.api.client.input.action.framework.VRActionButton;
+import org.jetbrains.annotations.NotNull;
+
+import java.util.Map;
+
+public class GameActionInventory extends VRActionButton {
+    /** QuestCraft: Vivecraft opens the inventory with Y, Visor has no action for it of its own. */
+    public static final String ID = "inventory";
+
+
+
+    public GameActionInventory(VRActionSet actionSet) {
+        super(actionSet, ID);
+    }
+
+
+    @Override
+    protected void onPress() {
+        InputHelper.pressKey(InputConstants.KEY_E);
+    }
+
+    @Override
+    protected void onRelease() {
+        InputHelper.releaseKey(InputConstants.KEY_E);
+    }
+
+
+
+    @Override
+    public @NotNull Map<VRInteractionProfileType, ActionBinding> getDefaultBindings() {
+        return Map.of();   // the Quest controllers get Y from QuestCraftBindings
+    }
+
+}
