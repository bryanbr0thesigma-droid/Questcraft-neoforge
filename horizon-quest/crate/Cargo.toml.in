[package]
name = "horizon-quest"
version = "0.1.0"
edition.workspace = true
license = "MIT"
publish = false
description = "Horizon on Meta Quest (QuestCraft): the game as an Android NativeActivity"

# The game module is horizon-client's own (src/game.rs and src/game/ link to it), built here as
# the library Android's NativeActivity loads. The dependencies below are horizon-client's
# (build.sh copies them from its Cargo.toml), with winit's Android backend.
[lib]
crate-type = ["cdylib"]
path = "src/lib.rs"

[features]
default = ["audio"]
audio = ["horizon-client-render/audio"]
# gilrs reads no controllers on Android: the Quest's come through OpenXR.
controllers = ["dep:gilrs", "dep:horizon-dualsense", "horizon-client-input/controllers"]

[dependencies]
horizon-client = { path = "../horizon-client", default-features = false }
@DEPENDENCIES@

[target.'cfg(unix)'.dependencies]
@UNIX_DEPENDENCIES@

[target.'cfg(target_os = "android")'.dependencies]
winit = { version = "0.30.13", features = ["android-native-activity"] }

[lints]
workspace = true
