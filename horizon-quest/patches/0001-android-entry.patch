@@ -347,6 +347,31 @@ use winit::{
     window::{CursorGrabMode, Window, WindowId},
 };
 
+/// Android (Meta Quest, QuestCraft's horizon-quest): the app the system started and the
+/// arguments its entry point passes, as there is no command line.
+#[cfg(target_os = "android")]
+pub static ANDROID: std::sync::OnceLock<(winit::platform::android::activity::AndroidApp, Vec<String>)> =
+    std::sync::OnceLock::new();
+
+/// The program's arguments: the command line's, on Android its entry point's.
+fn program_args() -> Vec<String> {
+    #[cfg(target_os = "android")]
+    if let Some((_, args)) = ANDROID.get() {
+        return args.clone();
+    }
+    std::env::args().skip(1).collect()
+}
+
+/// The event loop: on Android it is made with the app the system started.
+fn event_loop() -> std::result::Result<EventLoop<()>, EventLoopError> {
+    #[cfg(target_os = "android")]
+    if let Some((app, _)) = ANDROID.get() {
+        use winit::platform::android::EventLoopBuilderExtAndroid;
+        return EventLoop::builder().with_android_app(app.clone()).build();
+    }
+    EventLoop::new()
+}
