; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="QuestCraft"
config/description="VR launcher for Minecraft: Java Edition (Fabric, NeoForge, Quilt) on Meta Quest"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/config.gd"
Bridge="*res://scripts/bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray()

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
vrs/mode=2

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/foveation_level=0
shaders/enabled=true
