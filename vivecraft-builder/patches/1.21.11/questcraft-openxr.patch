+    /**
+     * Creates an array of XrStructs with their types preset to {@code type}
+     */
+    static ByteBuffer bufferStack(int capacity, int sizeof, int type) {
+        ByteBuffer b = stackCalloc(capacity * sizeof);
+
+        for (int i = 0; i < capacity; i++) {
+            b.position(i * sizeof);
+            b.putInt(type);
+        }
+        b.rewind();
+        return b;
+    }
