{
  "name": "Unity license (desktop in the browser)",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "unity",
      "webPort": "6080"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "Desktop (password: unity)", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/setup-unity-hub.sh",
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
