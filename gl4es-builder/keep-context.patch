diff --git a/src/glx/hardext.c b/src/glx/hardext.c
index c89a1237..d40f4fb0 100644
--- a/src/glx/hardext.c
+++ b/src/glx/hardext.c
@@ -150,11 +150,22 @@ void GetHardwareExtensions(int notest)
     LOAD_EGL(eglCreateContext);
     LOAD_EGL(eglQueryString);
     LOAD_EGL(eglTerminate);
+    LOAD_EGL(eglGetCurrentContext);
+    LOAD_EGL(eglGetCurrentDisplay);
+    LOAD_EGL(eglGetCurrentSurface);
 
     EGLDisplay eglDisplay;
     EGLSurface eglSurface;
     EGLContext eglContext;
 
+    // QuestCraft: the program may already have its context current on this thread (LWJGL loads gl4es right after
+    // making it current): it is given back after the test, and the display it lives on is not terminated
+    EGLContext prevContext = egl_eglGetCurrentContext ? egl_eglGetCurrentContext() : EGL_NO_CONTEXT;
+    EGLDisplay prevDisplay = egl_eglGetCurrentDisplay ? egl_eglGetCurrentDisplay() : EGL_NO_DISPLAY;
+    EGLSurface prevDraw = egl_eglGetCurrentSurface ? egl_eglGetCurrentSurface(EGL_DRAW) : EGL_NO_SURFACE;
+    EGLSurface prevRead = egl_eglGetCurrentSurface ? egl_eglGetCurrentSurface(EGL_READ) : EGL_NO_SURFACE;
+    int keepDisplay = prevContext != EGL_NO_CONTEXT;
+
     SHUT_LOGD("Using GLES %s backend\n", (hardext.esversion==1)?"1.1":"2.0");
 
     // Create a PBuffer first...
@@ -216,7 +227,7 @@ void GetHardwareExtensions(int notest)
     egl_eglBindAPI(EGL_OPENGL_ES_API);
     if (egl_eglInitialize(eglDisplay, NULL, NULL) != EGL_TRUE) {
         LOGE("Error while gathering supported extension (eglInitialize: %s), default to none\n", PrintEGLError(0));
-        egl_eglTerminate(eglDisplay);
+        if(!keepDisplay) egl_eglTerminate(eglDisplay);
         return;
     }
 
@@ -246,7 +257,7 @@ void GetHardwareExtensions(int notest)
 #endif
     if(!configsFound) {
         SHUT_LOGE("Error while gathering supported extension (eglChooseConfig: %s), default to none\n", PrintEGLError(0));
-        egl_eglTerminate(eglDisplay);
+        if(!keepDisplay) egl_eglTerminate(eglDisplay);
         return;
     }
     eglContext = egl_eglCreateContext(eglDisplay, pbufConfigs[0], EGL_NO_CONTEXT, (hardext.esversion==1)?egl_context_attrib:egl_context_attrib_es2);
@@ -258,7 +269,7 @@ void GetHardwareExtensions(int notest)
     if(!eglSurface) {
         SHUT_LOGE("Error while gathering supported extension (eglCreatePBufferSurface: %s), default to none\n", PrintEGLError(0));
         egl_eglDestroyContext(eglDisplay, eglContext);
-        egl_eglTerminate(eglDisplay);
+        if(!keepDisplay) egl_eglTerminate(eglDisplay);
         return;
     }
     egl_eglMakeCurrent(eglDisplay, eglSurface, eglSurface, eglContext);
@@ -488,6 +499,13 @@ void GetHardwareExtensions(int notest)
     egl_eglDestroySurface(eglDisplay, eglSurface);
     egl_eglDestroyContext(eglDisplay, eglContext);
 
-    egl_eglTerminate(eglDisplay);
+    if(keepDisplay) {
+        // QuestCraft: the program's context, current again as it was
+        if(egl_eglMakeCurrent(prevDisplay, prevDraw, prevRead, prevContext) != EGL_TRUE)
+            SHUT_LOGE("Could not make the program's context current again after the hardware test: %s\n", PrintEGLError(0));
+        else
+            SHUT_LOGD("Hardware test done, the program's context is current again\n");
+    } else
+        egl_eglTerminate(eglDisplay);
 #endif
 }
